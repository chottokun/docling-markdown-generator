# ==============================================================================
# Docling Markdown Generator - 環境変数設定テンプレート (.env.example)
# ==============================================================================
# このファイルをコピーして `.env` を作成し、必要に応じて設定を調整してください。
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VLM (Vision Language Model) / LLM 画像・図表キャプション生成設定
# ------------------------------------------------------------------------------
# ドキュメント内から抽出された画像・図表に対し、VLMを用いて自動的に日本語キャプション
# （説明文・グラフの傾向分析など）を生成してMarkdown内に埋め込む機能です。
#
# 【重要】デフォルトは `False`（無効）です。
# 無効時は外部APIやローカルLLMへの通信は一切行われません。
DOCLING_VLM_ENABLED=False

# 利用するVLMプロバイダを指定します。
# 選択肢: ollama | openai | vllm | llama.cpp | google (gemini) | anthropic
DOCLING_VLM_PROVIDER=ollama

# VLM / LLM のAPIキー（Ollamaや認証なしローカルサーバーの場合は空で構いません）
DOCLING_VLM_API_KEY=

# 利用するモデル名
#   - Ollama例: qwen2-vl:2b, qwen2-vl:7b, llava:latest
#   - OpenAI例: gpt-4o-mini, gpt-4o
#   - OpenAI互換 (vLLM / llama.cpp / LM Studio / LocalAI / LiteLLM) 例: Qwen/Qwen2-VL-7B-Instruct など
#   - Google例: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
#   - Anthropic例: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
DOCLING_VLM_MODEL=qwen2-vl:2b

# VLM APIのエンドポイントURL
#   - Ollama (ローカルPython環境から接続する場合): http://localhost:11434
#   - Ollama (DockerコンテナからホストPCで動作中のOllamaへ接続する場合): http://host.docker.internal:11434
#   - OpenAI 公式: https://api.openai.com/v1
#   - OpenAI 互換サーバー (vLLM / LM Studio / LiteLLM 等): http://localhost:8000/v1 (Dockerからは http://host.docker.internal:8000/v1)
#   - Google Gemini: https://generativelanguage.googleapis.com
#   - Anthropic: https://api.anthropic.com
DOCLING_VLM_ENDPOINT=http://localhost:11434

# 画像・図表の説明プロンプト
DOCLING_VLM_PROMPT="この画像の概要を1〜2文程度で簡潔に日本語で説明してください。なお、グラフや図表の場合は主要な数値や傾向（増減・ピークなど）を含めて説明してください。"

# 並列リクエスト時の最大同時接続数（セマフォによる流量制限）
DOCLING_VLM_MAX_CONCURRENT=5

# --- [設定例 1: ホストPC上の Ollama を利用する場合] ---
# DOCLING_VLM_ENABLED=True
# DOCLING_VLM_PROVIDER=ollama
# DOCLING_VLM_MODEL=qwen2-vl:2b
# DOCLING_VLM_API_KEY=  # Ollama利用時はAPIキー不要（空欄）
# # Base URL / エンドポイント（DockerコンテナからホストPCのOllamaへ接続する場合は host.docker.internal を指定）
# DOCLING_VLM_ENDPOINT=http://host.docker.internal:11434
# # ※ローカルPython (CLI等) からアクセスする場合は http://localhost:11434

# --- [設定例 2: ローカルの OpenAI 互換推論サーバー (vLLM / llama.cpp / LM Studio / LocalAI / LiteLLM 等) を利用する場合] ---
# DOCLING_VLM_ENABLED=True
# DOCLING_VLM_PROVIDER=openai  # または vllm / llama.cpp
# DOCLING_VLM_MODEL=Qwen/Qwen2-VL-7B-Instruct
# DOCLING_VLM_API_KEY=  # 認証不要なローカル推論サーバーの場合は空欄でOK
# # Base URL / エンドポイント（推論サーバーのURL）
# # - Dockerコンテナからアクセスする場合: http://host.docker.internal:8000/v1 (LM Studioなら http://host.docker.internal:1234/v1 など)
# # - ローカルPythonからアクセスする場合: http://localhost:8000/v1
# DOCLING_VLM_ENDPOINT=http://host.docker.internal:8000/v1

# --- [設定例 3: クラウド OpenAI (GPT-4o mini 等) を利用する場合] ---
# DOCLING_VLM_ENABLED=True
# DOCLING_VLM_PROVIDER=openai
# DOCLING_VLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
# DOCLING_VLM_MODEL=gpt-4o-mini
# DOCLING_VLM_ENDPOINT=https://api.openai.com/v1

# --- [設定例 4: Google Gemini を利用する場合] ---
# DOCLING_VLM_ENABLED=True
# DOCLING_VLM_PROVIDER=google
# DOCLING_VLM_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx
# DOCLING_VLM_MODEL=gemini-1.5-flash
# DOCLING_VLM_ENDPOINT=https://generativelanguage.googleapis.com

# --- [設定例 5: Anthropic Claude を利用する場合] ---
# DOCLING_VLM_ENABLED=True
# DOCLING_VLM_PROVIDER=anthropic
# DOCLING_VLM_API_KEY=sk-ant-api03-xxxxxxxxxxxx
# DOCLING_VLM_MODEL=claude-3-5-sonnet-20241022
# DOCLING_VLM_ENDPOINT=https://api.anthropic.com


# ------------------------------------------------------------------------------
# 2. セキュリティ & API 認証設定
# ------------------------------------------------------------------------------
# APIキー認証（設定すると、FastAPIの全APIで `X-API-Key` ヘッダーによる認証が必須になります。未設定時は認証無効）
# DOCLING_API_KEY=your-secure-api-key-here

# CORS 許可オリジン設定（カンマ区切り。例: http://localhost:3000,https://app.example.com。未設定時はCORS無効）
# DOCLING_CORS_ORIGINS=http://localhost:3000,https://example.com

# 最大アップロードファイルサイズ（バイト単位。デフォルト: 20MB = 20971520）
DOCLING_MAX_UPLOAD_SIZE=20971520

# IPベースのレートリミット（単位時間あたりの最大リクエスト数）
DOCLING_RATE_LIMIT_REQUESTS=5

# レートリミットの計測ウィンドウ（秒数。デフォルト: 60秒）
DOCLING_RATE_LIMIT_WINDOW=60

# 信頼するリバースプロキシのIP/CIDR（IPスプーフィング防止用。カンマ区切り、例: 127.0.0.1,10.0.0.0/8）
# DOCLING_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8


# ------------------------------------------------------------------------------
# 3. パフォーマンス & 並列処理設定
# ------------------------------------------------------------------------------
# マルチプロセス並列実行ワーカー数（GIL回避用 ProcessPoolExecutor のワーカー数）
DOCLING_MAX_WORKERS=2

# CPU/GPU 演算スレッド数
DOCLING_NUM_THREADS=4


# ------------------------------------------------------------------------------
# 4. Docling 変換パイプライン & ハードウェア設定
# ------------------------------------------------------------------------------
# GPU (CUDA) アクセラレーションの利用（True / False）
# ※ TrueでもGPU非対応環境や古いGPUの場合は自動的にCPUへフォールバックします。
DOCLING_USE_GPU=True

# FlashAttention2 の有効化（サポートされている最新NVIDIA GPUでVRAM削減と推論高速化）
DOCLING_CUDA_FLASH_ATTENTION=False

# OCR (光学文字認識) の有効化
DOCLING_DO_OCR=True

# 数式 (LaTeX) の抽出・認識の有効化
DOCLING_DO_FORMULA=True

# 図表 (チャート/グラフ) の抽出・解析の有効化
DOCLING_DO_CHART=False

# ソースコードブロックの高度な認識の有効化
DOCLING_DO_CODE=False

# テーブルの出力フォーマット（html | markdown | csv | tsv）
DOCLING_TABLE_FORMAT=html

# 抽出画像の解像度倍率（デフォルト: 2.0）
IMAGE_RESOLUTION_SCALE=2.0

# ページ区切りマーカー（<!-- PAGE_BREAK: Page N -->）の出力（RAGチャンキング用途）
DOCLING_INCLUDE_PAGE_BREAKS=False

# Key-Value 抽出メタデータの埋め込み（RAG用途）
DOCLING_INCLUDE_KV_EXTRACTION=False

# 数式 LaTeX の区切り文字カスタマイズ（auto | $ | $$ | \( | \[ 等）
DOCLING_MATH_INLINE_DELIM=auto
DOCLING_MATH_BLOCK_DELIM=auto
DOCLING_MATH_BLOCK_NEWLINE=auto


# ------------------------------------------------------------------------------
# 5. ストレージ & ログ設定
# ------------------------------------------------------------------------------
# ファイル保存先ディレクトリ（ローカル実行時）
DOCLING_UPLOAD_DIR=uploads
DOCLING_OUTPUT_DIR=output

# Docker Compose ログローテーション設定
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
